# ==================== Application ====================
ENVIRONMENT=production
DEBUG=false

# ==================== Database ====================
POSTGRES_USER=diting
POSTGRES_PASSWORD=admin@123
POSTGRES_DB=diting_web
POSTGRES_PORT=5432

# ==================== Redis ====================
REDIS_PORT=6379

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=admin@123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=diting-datasets

# ==================== JWT Authentication ====================
# Generate a secure key using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=BBXl3CYXz2F0rI9mHqjP8K6cb4xNfZ2r1wqkA7yUoVs
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== Admin User ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# ==================== LLM Configuration ====================
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT=60.0

# ==================== Embedding Configuration ====================
DEFAULT_EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_TIMEOUT=60.0

# ==================== Service Ports ====================
BACKEND_PORT=8000
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443

# ==================== Docker Images ====================
BACKEND_IMAGE=diting-backend:latest
WORKER_IMAGE=diting-worker:latest
FRONTEND_IMAGE=diting-frontend:latest
REDIS_IMAGE=diting-redis:latest

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000"]

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== Database Connection Pool ====================
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
