# ==================== DiTing Web 生产环境配置模板 ====================
# 使用方法: 复制此文件为 .env.production 并修改相应的值
# cp env.production.template .env.production

# ==================== 应用配置 ====================
ENVIRONMENT=production
DEBUG=false
PYTHON_VERSION=3.11
NODE_VERSION=20

# ==================== 数据库配置 ====================
POSTGRES_USER=diting
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=diting_web
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==================== Redis 配置 ====================
REDIS_PORT=6379

# ==================== MinIO 配置 ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false
MINIO_BUCKET_NAME=diting-datasets
MINIO_BROWSER_REDIRECT_URL=http://your-domain.com:9001

# ==================== JWT 认证 ====================
# 生成方式: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=your_secure_jwt_secret_key_here_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 管理员账户 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# ==================== LLM 配置 ====================
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here
LLM_TIMEOUT=60.0

# ==================== Embedding 配置 ====================
DEFAULT_EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://your-embedding-service:8001
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_TIMEOUT=60.0

# ==================== CORS 配置 ====================
CORS_ORIGINS=["http://localhost","http://your-domain.com","https://your-domain.com"]

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== Worker 配置 ====================
WORKER_REPLICAS=2
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=3600

# ==================== 前端配置 ====================
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
VITE_API_BASE_URL=http://your-domain.com

# ==================== UV 镜像源 ====================
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

